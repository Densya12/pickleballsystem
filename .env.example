# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys.
#
# Local dev (npx supabase start): use the API URL and publishable key it prints.
# Cloud: Supabase dashboard → Project Settings → API Keys (publishable key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Older projects may use the legacy anon key instead; either name works:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Never put the service role / secret key in a NEXT_PUBLIC_ variable or app code.

# Optional: "May puna o problema?" link in Settings and on the session summary
# (e.g. a Google Form or a Messenger link). The link is hidden when this is empty.
NEXT_PUBLIC_FEEDBACK_URL=

# Public URL of the app (no trailing slash). Auth redirects, QR links and invite links use it
# when a request's host isn't on the allowlist below, so a forged X-Forwarded-Host can't
# send people elsewhere (QA-08). Local dev: http://localhost:3000. Production: your main URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Extra hosts the app may build links for, comma-separated, no scheme (e.g. a custom domain
# and its www). Vercel's own hosts (VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL), the host of
# NEXT_PUBLIC_SITE_URL and localhost are always allowed. Leave empty if you only use those.
ALLOWED_HOSTS=

# Optional: contact email shown at the bottom of /terms and /privacy ("Questions or requests: …").
# The line is hidden when this is empty.
NEXT_PUBLIC_CONTACT_EMAIL=
